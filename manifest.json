{
  "manifest_version": 2,
  "name": "SortFolders",
  "description": "Clean-room personal manager for account ordering, folder sorting, and startup folder selection in Thunderbird 140.0+.",
  "version": "1.5.1",
  "author": "CybTekSol [ https://github.com/CybTekSol ]",
  "browser_specific_settings": {
    "gecko": {
      "id": "sortfolders@personal.local",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png"
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "storage",
    "menus",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "SortFolders",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  },
  "experiment_apis": {
    "FolderSort": {
      "schema": "api/FolderSort/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["FolderSort"]],
        "script": "api/FolderSort/implementation.js"
      }
    }
  }
}